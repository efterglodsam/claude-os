# Kopiera till .env och fyll i. Allt utom ANTHROPIC_API_KEY är valfritt.

# --- Agenterna (Claude) ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5     # t.ex. claude-sonnet-5-5 för lägre kostnad
# CEO_MODEL=                       # valfri egen modell för CEO-agenterna (annars samma som CLAUDE_MODEL)
# CLAUDE_MOCK=1                    # kör hela flödet utan Claude-anrop (test)

# --- Klippinställningar (anpassa efter communityts regler) ---
# MIN_CLIP_SECONDS=20
# MAX_CLIP_SECONDS=90
# MAX_CLIPS_PER_JOB=5
# CLIP_LAYOUT=vertical             # vertical (9:16) eller original
# CLIP_CAPTIONS=1                  # 0 = inga inbrända undertexter
# WHISPER_MODEL=base               # om whisper är installerat och videon saknar undertexter

# --- Discord ---
# Postning av färdiga klipp (enklast: webhook på din egen kanal)
DISCORD_WEBHOOK_URL=
# Bot (krävs för regelsynk och Discord-statistik; boten måste vara tillagd i servern)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_RULES_CHANNEL_ID=
DISCORD_SUBMIT_CHANNEL_ID=

# --- Statistik ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
TIKTOK_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
